# Copy to .env.local and fill in. NEVER commit .env.local.

# Canonical site URL — overrides content/seo.json "domain" when that is empty.
NEXT_PUBLIC_SITE_URL=

# Visitor counter (features.visitorCounter) — free Upstash Redis REST credentials.
# Create a database at https://console.upstash.com, copy REST URL + token.
# If unset, the counter quietly hides itself; nothing breaks.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
